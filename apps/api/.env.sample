# Supabase — trên Vercel web và API dùng chung 2 biến này
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# Postgres pooling URL (Supabase → Connect → Transaction pooler, port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres

# AI assistant — đặt ít nhất 1 key; ưu tiên Anthropic → OpenAI → Gemini
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Local only (production mặc định DB_SSL=true, DB_SYNCHRONIZE=false)
# DB_SSL=false
# DB_SYNCHRONIZE=true
