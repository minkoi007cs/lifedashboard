# ==============================================================================
# LifeDashboard Backend Environment Variables
# ==============================================================================
# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:your-password@your-host:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:your-password@your-host:5432/postgres?sslmode=require"

# Auth & Security
JWT_SECRET="your-jwt-secret-string"
FRONTEND_URL="https://life.minkoi.org"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="https://life-api.minkoi.org/auth/google/callback"

# AI Integrations (Optional)
ANTHROPIC_API_KEY=""
