# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ─── Database (Supabase) ─────────────────────────────────────────────────────
# Use the Session-mode pooler URL (port 5432) for Vercel serverless
DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@[region].pooler.supabase.com:5432/postgres
DB_SSL=true
# DANGER: keep false in production — auto-sync can drop/alter columns.
# Run TypeORM migrations instead: npm run migration:run --workspace apps/backend
DB_SYNCHRONIZE=false

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars

GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
# Must match an Authorized Redirect URI in Google Cloud Console → OAuth 2.0 credentials
GOOGLE_CALLBACK_URL=https://your-backend.vercel.app/api/v1/auth/google/callback

# ─── CORS / OAuth redirect ───────────────────────────────────────────────────
FRONTEND_URL=https://your-frontend.vercel.app
# Optional: extra comma-separated origins (e.g. Vercel preview branches)
# ALLOWED_ORIGINS=https://your-app-git-staging-team.vercel.app

# ─── Dev only — NEVER set in production ──────────────────────────────────────
# DEV_LOGIN_ENABLED=true
